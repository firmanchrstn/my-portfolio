# Normalise to UTF-8 without BOM, LF in the repository, LF in the working tree.
# `node tools/verify.js` fails the build if a file drifts from these rules.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
